---
layout: null
permalink: /search.json
---
[
  {% assign sep = "" %}
  {% for post in site.posts %}
    {{ sep }}
    {
      "title": {{ post.title | jsonify }},
      "url": "{{ post.url | prepend: site.baseurl }}",
      "content": {{ post.content | strip_html | truncatewords: 100 | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "categories": {{ post.categories | jsonify }},
      "lang": {{ post.lang | jsonify }},
      "type": "post",
      "date": "{{ post.date | date_to_xmlschema }}"
    }
    {% assign sep = "," %}
  {% endfor %}

  {% for pg in site.pages %}
    {% if pg.title and pg.ref %}
      {{ sep }}
      {
        "title": {{ pg.title | jsonify }},
        "url": "{{ pg.url | prepend: site.baseurl }}",
        "content": {{ pg.content | strip_html | truncatewords: 100 | jsonify }},
        "lang": {{ pg.lang | jsonify }},
        "type": "page",
        "ref": {{ pg.ref | jsonify }}
      }
      {% assign sep = "," %}
    {% endif %}
  {% endfor %}

  {% for product_entry in site.data.products %}
    {% assign sku = product_entry[0] %}
    {% assign product = product_entry[1] %}
    {% for lang_code in site.languages %}
      {% assign pinfo = product[lang_code] %}
      {% if pinfo %}
        {{ sep }}
        {
          "title": {{ pinfo.title | jsonify }},
          "url": "{{ site.baseurl }}{% if lang_code != site.default_lang %}/{{ lang_code }}{% endif %}/products/{{ pinfo.slug | default: sku }}/",
          "content": {{ pinfo.description | jsonify }},
          "tags": {{ product.tags | jsonify }},
          "categories": {{ product.categories | jsonify }},
          "lang": {{ lang_code | jsonify }},
          "type": "product",
          "ref": {{ sku | jsonify }}
        }
        {% assign sep = "," %}
      {% endif %}
    {% endfor %}
  {% endfor %}
]
