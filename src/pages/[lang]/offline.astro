---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStaticPathsForLang, getLangPrefix } from "../../config/site.js";

export function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang } = Astro.props;
const langPrefix = getLangPrefix(lang);

const title = lang === "tr" ? "Çevrimdışısınız" : "You are offline";
const description = lang === "tr" 
  ? "Bu sayfayı görüntülemek için internet bağlantısı gerekiyor. Bağlantınızı kontrol edip tekrar deneyin." 
  : "An internet connection is required to view this page. Please check your connection and try again.";
const backToHome = lang === "tr" ? "Ana sayfaya dön" : "Back to home";
---

<BaseLayout title={`${title} | Offline`} description={description} lang={lang} noindex={true}>
  <div class="max-w-xl mx-auto px-4 py-16 text-center">
    <h1 class="text-2xl font-bold font-heading text-jam-text dark:text-jam-text-dark mb-4">
      {title}
    </h1>
    <p class="text-slate-600 dark:text-slate-400 mb-6">
      {description}
    </p>
    <a
      href={`${langPrefix}/`}
      class="inline-flex px-6 py-3 rounded-lg font-medium bg-jam-primary text-white hover:bg-blue-600 transition-colors"
    >
      {backToHome}
    </a>
  </div>
</BaseLayout>
