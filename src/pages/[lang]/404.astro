---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, getLangPrefix, getStaticPathsForLang } from "../../config/site.js";
import { t } from "../../i18n";

export function getStaticPaths() {
  return getStaticPathsForLang();
}

const { lang } = Astro.props;
const i18n = t(lang);
const base = site.baseUrl || "";
const langPrefix = getLangPrefix(lang);

const title = lang === "tr" ? "Sayfa bulunamadı" : "Page not found";
const description = lang === "tr" ? "Aradığınız sayfa bulunamadı." : "The page you are looking for could not be found.";
const backToHome = lang === "tr" ? "Ana Sayfa" : "Back to Home";
---

<BaseLayout title={`${title} | ${site.title}`} description={description} lang={lang} noindex>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-bold font-heading text-jam-primary mb-4">404</h1>
    <p class="text-xl text-slate-600 dark:text-slate-400 mb-8">{description}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={`${base}${langPrefix}/`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-jam-primary text-white font-medium hover:bg-jam-primary/90 transition-colors">
        {backToHome}
      </a>
      <a href={`${base}${langPrefix}/blog/`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-jam-border dark:border-jam-border-dark font-medium hover:border-jam-primary transition-colors">
        Blog
      </a>
    </div>
  </div>
</BaseLayout>
