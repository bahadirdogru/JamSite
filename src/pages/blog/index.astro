---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogListLoadMore from "../../components/BlogListLoadMore.svelte";
import { getCollection } from "astro:content";
import { t } from "../../i18n";
import { site, getLangPrefix } from "../../config/site";

const lang = "tr";
const posts = (await getCollection("posts"))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const postsForJson = posts.map((p) => ({
  id: p.id.replace(/\.md$/, ""),
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString(),
  dateFormatted: p.data.date.toLocaleDateString("tr-TR"),
}));
const i18n = t(lang);
const base = site.baseUrl || "";
const langPrefix = getLangPrefix(lang);
---

<BaseLayout title={`${i18n.blog_title} | ${site.title}`} description={site.description} lang={lang}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold font-heading text-jam-primary mb-8">{i18n.blog_title}</h1>
    <BlogListLoadMore
      client:visible
      postsJson={JSON.stringify(postsForJson)}
      base={base}
      langPrefix={langPrefix}
      loadMoreLabel="Daha fazla"
    />
  </div>
</BaseLayout>
