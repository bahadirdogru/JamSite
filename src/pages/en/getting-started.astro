---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n";
import { site } from "../../config/site";

const lang = "en";
const i18n = t(lang);
const base = site.baseUrl || "";
---

<BaseLayout
  title="Getting Started | JamSite"
  description="Set up JamSite and get running in minutes"
  lang={lang}
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold font-heading mb-4">Getting Started</h1>
      <p class="text-xl text-slate-600 dark:text-slate-400">
        Set up JamSite in minutes and start customizing.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-2xl font-bold font-heading mb-4">Requirements</h2>
      <ul class="space-y-3">
        <li class="flex items-center gap-3 p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <span class="text-green-500">✓</span>
          <span><strong>Node.js</strong> (v18+)</span>
          <a href="https://nodejs.org/" target="_blank" rel="noopener" class="ml-auto text-jam-primary text-sm hover:underline">Download</a>
        </li>
        <li class="flex items-center gap-3 p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <span class="text-green-500">✓</span>
          <span><strong>Git</strong></span>
          <a href="https://git-scm.com/" target="_blank" rel="noopener" class="ml-auto text-jam-primary text-sm hover:underline">Download</a>
        </li>
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold font-heading mb-4">Installation</h2>
      <div class="p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-sm overflow-x-auto">
        <div class="text-slate-400"># Clone the project</div>
        <div>git clone https://github.com/bahadirdogru/JamSite.git</div>
        <div class="mt-3 text-slate-400"># Install dependencies</div>
        <div>cd JamSite && npm install</div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold font-heading mb-4">Development</h2>
      <p class="text-slate-600 dark:text-slate-400 mb-4">Run the Astro dev server:</p>
      <div class="p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-sm">
        npm run dev
      </div>
      <p class="text-slate-600 dark:text-slate-400 mt-4">Production build:</p>
      <div class="p-4 rounded-xl bg-slate-900 text-slate-100 font-mono text-sm mt-2">
        npm run build
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold font-heading mb-4">Deployment</h2>
      <p class="text-slate-600 dark:text-slate-400">Run <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-700 rounded">npm run build</code> and deploy the <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-700 rounded">dist/</code> output to GitHub Pages or any static host. Without GitHub Actions, build locally and push the <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-700 rounded">dist/</code> contents to a gh-pages branch.</p>
    </section>

    <div class="mt-16 p-8 rounded-2xl bg-gradient-to-br from-jam-primary/10 to-jam-secondary/10 dark:from-jam-primary/20 dark:to-jam-secondary/20 text-center">
      <a href={`${base}/en/features/`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium hover:border-jam-primary transition-colors mr-2">
        Features
      </a>
      <a href={`${base}/en/about/`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium hover:border-jam-primary transition-colors">
        About
      </a>
    </div>
  </div>
</BaseLayout>
