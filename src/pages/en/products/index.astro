---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProductsFilterSort from "../../../components/ProductsFilterSort.svelte";
import { getProducts } from "../../../data/products";
import { t } from "../../../i18n";
import { site } from "../../../config/site";

const lang = "en";
const products = getProducts().filter((p) => p.en).map((p) => ({ product: p, info: p.en }));
const i18n = t(lang);
const base = site.baseUrl || "";
const productsJson = JSON.stringify(products);
---

<BaseLayout title={`${i18n.products_title} | ${site.title}`} description={site.description} lang={lang}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold font-heading text-jam-primary mb-8">{i18n.products_title}</h1>
    <ProductsFilterSort
      client:visible
      productsJson={productsJson}
      base={base}
      langPrefix="/en"
      sortLabel={i18n.sort_by ?? "Sort"}
      sortNameAsc="Name A-Z"
      sortNameDesc="Name Z-A"
      sortPriceAsc="Price (low to high)"
      sortPriceDesc="Price (high to low)"
    categoriesLabel={i18n.categories_filter}
    tagsLabel={i18n.tags_filter}
    clearLabel={i18n.clear}
    loadMoreLabel="Load more"
  />
  </div>
</BaseLayout>
