---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButton from "../../../components/ShareButton.svelte";
import { getProductPaths, getProductBySlug } from "../../../data/products";
import { t } from "../../../i18n";
import { site } from "../../../config/site";

export async function getStaticPaths() {
  const paths = getProductPaths().filter((p) => p.lang === "en");
  return paths.map(({ slug }) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const result = getProductBySlug(slug, "en");
if (!result) return Astro.redirect("/404");
const { product, info } = result;
const lang = "en";
const i18n = t(lang);
const base = site.baseUrl || "";
const canonicalUrl = `${site.url || ""}${base}/en/products/${slug}/`;
const breadcrumbs = [
  { name: "Home", url: `${site.url || ""}${base}/en/` },
  { name: "Products", url: `${site.url || ""}${base}/en/products/` },
  { name: info.title, url: canonicalUrl },
];
const priceNum = parseFloat(String(product.price).replace(/[^\d.-]/g, "")) || 0;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      name: info.title,
      description: info.description,
      image: product.image || undefined,
      url: canonicalUrl,
      offers: {
        "@type": "Offer",
        price: priceNum,
        priceCurrency: product.currency || "TRY",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    },
  ],
};
---

<BaseLayout
  title={`${info.title} | ${site.title}`}
  description={info.description}
  lang={lang}
  ogImage={product.image}
  jsonLd={jsonLd}
>
  <article class="max-w-5xl mx-auto px-4 py-12">
    <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <ol class="flex flex-wrap gap-2 [&>li]:flex [&>li]:items-center [&>li]:gap-2">
        <li><a href={`${base}/en/`} class="hover:text-jam-primary">Home</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li><a href={`${base}/en/products/`} class="hover:text-jam-primary">Products</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li class="text-jam-text dark:text-jam-text-dark">{info.title}</li>
      </ol>
    </nav>
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <div>
        {product.image && product.image !== "" ? (
          <img
            src={product.image}
            alt={info.title}
            width={800}
            height={800}
            loading="lazy"
            decoding="async"
            class="w-full aspect-square object-cover rounded-xl shadow-sm border border-jam-border dark:border-jam-border-dark"
          />
        ) : (
          <div class="w-full aspect-square rounded-xl bg-slate-200 dark:bg-slate-700 flex items-center justify-center">
            <svg class="w-20 h-20 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        )}
        {product.images && product.images.length > 0 && (
          <div class="grid grid-cols-3 gap-2 mt-4">
            {product.images.map((img) => (
              <img
                src={img}
                alt={info.title}
                width={200}
                height={200}
                loading="lazy"
                decoding="async"
                class="w-full aspect-square object-cover rounded-lg border border-jam-border dark:border-jam-border-dark"
              />
            ))}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold font-heading text-jam-text dark:text-jam-text-dark mb-3">{info.title}</h1>
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <ShareButton
            client:visible
            title={info.title}
            text={info.description}
            url={canonicalUrl}
            labelShare={i18n.share_label?.replace(":", "") ?? "Share"}
            labelCopy={i18n.copy_link}
            labelCopied={i18n.link_copied}
          />
        </div>
        <p class="text-2xl text-jam-primary font-bold mb-6">
          {product.price} {product.currency}
        </p>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">{info.description}</p>

        {info.tags && info.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {info.tags.map((tag) => (
              <span class="px-2.5 py-1 text-xs bg-jam-accent/10 text-jam-accent rounded-full">{tag}</span>
            ))}
          </div>
        )}

        {info.categories && info.categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {info.categories.map((cat) => (
              <span class="px-2.5 py-1 text-xs bg-jam-secondary/10 text-jam-secondary rounded-full">{cat}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
