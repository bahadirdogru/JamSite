---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareButton from "../../../components/ShareButton.svelte";
import { getCollection } from "astro:content";
import { t } from "../../../i18n";
import { site } from "../../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.lang === "en");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const lang = "en";
const i18n = t(lang);
const base = site.baseUrl || "";
const slug = post.id.replace(/\.md$/, "");
const canonicalUrl = `${site.url || ""}${base}/en/blog/${slug}/`;
const breadcrumbs = [
  { name: "Home", url: `${site.url || ""}${base}/en/` },
  { name: "Blog", url: `${site.url || ""}${base}/en/blog/` },
  { name: post.data.title, url: canonicalUrl },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: post.data.title,
      description: post.data.description,
      image: post.data.image ? (post.data.image.startsWith("http") ? post.data.image : `${site.url || ""}${base}${post.data.image}`) : undefined,
      datePublished: post.data.date.toISOString(),
      dateModified: post.data.date.toISOString(),
      author: { "@type": "Organization", name: site.title },
      url: canonicalUrl,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title} | ${site.title}`}
  description={post.data.description}
  lang={lang}
  ogImage={post.data.image}
  jsonLd={jsonLd}
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <ol class="flex flex-wrap gap-2 [&>li]:flex [&>li]:items-center [&>li]:gap-2">
        <li><a href={`${base}/en/`} class="hover:text-jam-primary">Home</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li><a href={`${base}/en/blog/`} class="hover:text-jam-primary">Blog</a></li>
        <li><span aria-hidden="true">/</span></li>
        <li class="text-jam-text dark:text-jam-text-dark">{post.data.title}</li>
      </ol>
    </nav>
    <header class="mb-8">
      <h1 class="text-3xl font-bold font-heading text-jam-text dark:text-jam-text-dark">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 mt-2">
        <time class="text-sm text-slate-500 dark:text-slate-400" datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US")}
        </time>
        <ShareButton
          client:visible
          title={post.data.title}
          text={post.data.description}
          url={canonicalUrl}
          labelShare={i18n.share_label?.replace(":", "") ?? "Share"}
          labelCopy={i18n.copy_link}
          labelCopied={i18n.link_copied}
        />
      </div>
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          width={1200}
          height={400}
          loading="lazy"
          decoding="async"
          class="mt-4 rounded-lg w-full object-cover max-h-64"
        />
      )}
    </header>
    <div class="prose prose-slate dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
