---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { t } from "../i18n";
import { site, getLangPrefix } from "../config/site";

const lang = "tr";
const posts = (await getCollection("posts")).filter((p) => p.data.lang === lang);
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
const i18n = t(lang);
const base = site.baseUrl || "";
const langPrefix = getLangPrefix(lang);
---

<BaseLayout title={`${i18n.tags_title} | ${site.title}`} description={site.description} lang={lang}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold font-heading text-jam-primary mb-8">{i18n.tags_title}</h1>
    <ul class="flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <li>
          <a
            href={`${base}${langPrefix}/blog/?tag=${encodeURIComponent(tag)}`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-jam-primary hover:text-white transition-colors"
          >
            {tag}
            <span class="text-xs opacity-75">({count})</span>
          </a>
        </li>
      ))}
    </ul>
    {tags.length === 0 && <p class="text-slate-500 dark:text-slate-400">Henüz etiket yok.</p>}
  </div>
</BaseLayout>
